{
  "name": "@preeternal/jws-verifier",
  "version": "0.0.1-rc.1",
  "packageManager": "yarn@4.18.1",
  "description": "TypeScript library for secure JWS verification, X.509 certificate chain validation, and OCSP revocation checking",
  "homepage": "https://github.com/Preeternal/jws-verifier#readme",
  "bugs": {
    "url": "https://github.com/Preeternal/jws-verifier/issues"
  },
  "license": "MIT",
  "author": "Preeternal <preeternal@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Preeternal/jws-verifier.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "yarn run lint && yarn run typecheck && yarn run deps:lint && yarn run security:lint && yarn run test:coverage",
    "deps:lint": "depcruise --config .dependency-cruiser.cjs source test",
    "dev": "tsc --watch",
    "format": "oxfmt . --write",
    "lint": "biome check --error-on-warnings . && oxlint --deny-warnings . && oxfmt --check .",
    "attw": "attw --pack . --profile esm-only",
    "benchmark": "node --experimental-strip-types --disable-warning=ExperimentalWarning benchmark/runner.mjs",
    "benchmark:codec": "yarn run build && node --experimental-strip-types benchmark/codec-runner.mjs",
    "benchmark:ci": "yarn run build && yarn benchmark -- --adapter ./benchmark/verifier-adapter.mjs --baseline ./benchmark/reference-adapter.mjs --mode all --samples 15 --warmup 3 --batch 20 --json",
    "prepare": "lefthook install",
    "prepublishOnly": "yarn run check && yarn run build && yarn run verify:artifacts && yarn run publint && yarn run types:lint",
    "publint": "publint --pack yarn",
    "release:check": "yarn run prepublishOnly && yarn run verify:package",
    "security:lint": "node scripts/security-lint.mjs",
    "setup:editor": "yarn sdks vscode",
    "size:report": "npm pack --dry-run --json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke:apple": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit",
    "types:lint": "attw --pack . --profile esm-only",
    "verify:artifacts": "node -e \"for (const file of ['dist/index.js','dist/index.d.ts']) require('node:fs').statSync(file)\"",
    "verify:package": "node scripts/verify-package.mjs",
    "workerd:smoke": "yarn run build && node scripts/workerd-smoke.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.16",
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.8",
    "@yarnpkg/sdks": "^3.3.1",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "0.28.2",
    "lefthook": "^2.1.9",
    "miniflare": "5.20261103.0-beta",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "@types/node": "^22",
    "@yarnpkg/core": "4.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
